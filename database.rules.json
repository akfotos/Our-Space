{
  "rules": {
    "userCouples": {
      "$uid": {
        ".read": "auth != null && auth.uid == $uid",
        ".write": "auth != null && auth.uid == $uid"
      }
    },
    "chat": {
      "$coupleId": {
        ".read": "auth != null && root.child('userCouples').child(auth.uid).val() == $coupleId",
        ".write": "auth != null && root.child('userCouples').child(auth.uid).val() == $coupleId",
        "messages": {
          ".indexOn": ["timestamp"]
        },
        "typing": {
          "$uid": {
            ".write": "auth != null && auth.uid == $uid && root.child('userCouples').child(auth.uid).val() == $coupleId"
          }
        }
      }
    },
    "playerState": {
      "$coupleId": {
        ".read": "auth != null && root.child('userCouples').child(auth.uid).val() == $coupleId",
        ".write": "auth != null && root.child('userCouples').child(auth.uid).val() == $coupleId"
      }
    },
    "presence": {
      "$coupleId": {
        ".read": "auth != null && root.child('userCouples').child(auth.uid).val() == $coupleId",
        "$uid": {
          ".write": "auth != null && auth.uid == $uid && root.child('userCouples').child(auth.uid).val() == $coupleId",
          ".validate": "newData.hasChildren(['online', 'lastSeen', 'name'])"
        }
      }
    }
  }
}